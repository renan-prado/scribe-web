# ─────────────────────────────────────────────────────────────────────
# Modelo dos dois arquivos de ambiente. Copie para os dois e preencha:
#
#   cp .env.example .env.dev     → npm run dev   (Supabase de dev,  Stripe teste)
#   cp .env.example .env.prod    → npm run prod  (Supabase de prod, Stripe live)
#
# Nenhum dos dois é lido pelo Next automaticamente — a escolha é sempre
# explícita, feita por scripts/with-env.mjs a partir do script de npm.
# Detalhes e armadilhas: docs/ambientes.md.
#
# Este arquivo é o ÚNICO da família .env que vai para o git. Nunca coloque
# um valor real aqui.
# ─────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────
# Project Settings → API. O project ref é o subdomínio da URL, e é dele que
# `npm run db:push` deriva em qual projeto aplicar as migrações.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: evita o prompt de senha no `supabase link` do db:push.
# SUPABASE_DB_PASSWORD=

# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# Overrides opcionais de modelo. Os defaults estão em lib/env/server.ts —
# só declare aqui o que quiser mudar.
# OPENAI_TRANSCRIBE_MODEL=
# OPENAI_INSIGHTS_MODEL=
# OPENAI_FINAL_SUMMARY_MODEL=

# ── Stripe ──────────────────────────────────────────────────────────
# Opcionais: sem elas o app sobe e /api/billing/* responde 503
# billing_unavailable, em vez de derrubar o processo no import.
#
# Os IDs de preço NÃO atravessam os modos — os de teste só existem em teste,
# os de live só em live. Rode `npm run stripe:doctor` para conferir se a
# chave e os preços estão no mesmo modo.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PESSOAL=
STRIPE_PRICE_ESTUDIOSO=
STRIPE_PRICE_TOPUP_500=
# Em dev: o whsec_ que `npm run stripe:listen` imprime.
# Em prod: o do endpoint cadastrado no dashboard, em modo live.
# Usar o errado é a falha mais silenciosa do fluxo — o pagamento passa e o
# crédito não entra, sem erro na tela.
STRIPE_WEBHOOK_SECRET=

# Base absoluta das URLs de retorno do Checkout.
#   dev   http://localhost:3000
#   prod  https://scriba.cc
APP_URL=http://localhost:3000

# ── Cron ────────────────────────────────────────────────────────────
# Guarda de /api/billing/sweep. Mínimo 16 caracteres; use valores DIFERENTES
# em dev e prod. Gere com:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
