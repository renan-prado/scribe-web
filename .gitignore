# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.dev e .env.prod carregam segredos reais e ficam fora do git.
# O modelo sem valores é a única exceção. Ver docs/ambientes.md.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local screenshots / working prints
/public/prints/

# supabase CLI local cache
/supabase/.temp/
/supabase/.branches/

# playwright MCP cache
/.playwright-mcp/

# local scratch: session dumps, comparison files, scripts de teste manual
/tmp/
/compare*.json
/compare*.txt
/overview.txt

/tasks*