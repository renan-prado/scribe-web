{
  "name": "scriba-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "claude": "claude --dangerously-skip-permissions",
    "dev": "node scripts/with-env.mjs dev -- next dev",
    "prod": "node scripts/with-env.mjs prod -- next dev",
    "build": "next build",
    "start": "next start",
    "build:dev": "node scripts/with-env.mjs dev -- next build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/db-push.mjs dev",
    "db:push:prod": "node scripts/db-push.mjs prod",
    "stripe:doctor": "node scripts/stripe-doctor.mjs .env.dev",
    "stripe:doctor:prod": "node scripts/stripe-doctor.mjs .env.prod",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@next/third-parties": "^16.3.4",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
